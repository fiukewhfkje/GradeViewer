{
  "name": "gradeviewer-pwa",
  "version": "0.2.4",
  "private": true,
  "passwordSchema": 1,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/service-worker.mjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "benchmark:refresh": "node scripts/benchmark-refresh.mjs",
    "preview": "wrangler dev --port 8787",
    "preview:local": "npm run build && wrangler dev --local --config wrangler.test.jsonc --ip 127.0.0.1 --port 8917 --local-protocol https --persist-to .local-test/settings-preview/state",
    "deploy": "node scripts/deploy.mjs",
    "release:package": "node scripts/package-release.mjs",
    "update": "node scripts/update.mjs",
    "update:copy": "node scripts/update-copy.mjs",
    "repair:copy": "node scripts/repair-copy.mjs",
    "verify:live": "node --use-env-proxy scripts/verify-live.mjs",
    "verify:live:snapshot": "node --use-env-proxy scripts/verify-live-snapshot.mjs",
    "verify:hosted": "node --use-env-proxy scripts/verify-hosted.mjs"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "http-link-header": "^1.1.4",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/http-link-header": "^1.0.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.45.0"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "Choose a new password just for GradeViewer (at least 12 characters). Generate and save it with your password manager. You will enter it to unlock your app after deployment."
      }
    }
  }
}
