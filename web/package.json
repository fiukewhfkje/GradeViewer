{
  "name": "gradeviewer-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "release:package": "node scripts/package-release.mjs",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0",
    "playwright-core": "^1.56.0"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "Choose a private app password (at least 20 characters; your password manager can generate one). Keep it safe. You will use it once to unlock your app. This is NOT your school password."
      }
    }
  }
}
